OPENAI_API_KEY=
GROQ_API_KEY=
RESOLVEAI_ENVIRONMENT=local
RESOLVEAI_LOG_LEVEL=INFO
RESOLVEAI_SERVICE_NAME="ResolveAI API"
RESOLVEAI_MODEL_PROVIDER=groq
RESOLVEAI_MODEL_NAME=llama-3.1-8b-instant
RESOLVEAI_MODEL_TEMPERATURE=0
RESOLVEAI_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
RESOLVEAI_RAG_ENABLED=true
RESOLVEAI_RAG_COLLECTION_NAME=resolveai_knowledge
RESOLVEAI_RAG_TOP_K=4
RESOLVEAI_RAG_VOICE_TOP_K=4
RESOLVEAI_RAG_CHUNK_SIZE=1000
RESOLVEAI_RAG_CHUNK_OVERLAP=150
RESOLVEAI_RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RESOLVEAI_RAG_EMBEDDING_DIMENSIONS=384
RESOLVEAI_QDRANT_URL=http://localhost:6333
RESOLVEAI_QDRANT_STORAGE_PATH=.qdrant
QDRANT_API_KEY=
RESOLVEAI_OTEL_ENABLED=false
RESOLVEAI_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Auth: comma-list of allowed API keys. Empty = auth disabled.
RESOLVEAI_AUTH_API_KEYS=[]
RESOLVEAI_RATE_LIMIT_ENABLED=true
RESOLVEAI_RATE_LIMIT_REQUESTS=60
RESOLVEAI_RATE_LIMIT_WINDOW_SECONDS=60
RESOLVEAI_REQUEST_MAX_BODY_BYTES=5242880

# memory = in-process LangGraph checkpointer (thread-id memory across calls).
# none = no checkpointer.
RESOLVEAI_AGENT_CHECKPOINT_BACKEND=memory

RESOLVEAI_RAG_SEARCH_MULTIPLIER=3
